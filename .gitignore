# Private local state
/.deckagent/
# PO's private working folder
/po/
**/.env
**/.env.*
!/.env.example

# Google OAuth credentials must never be committed
client_secret*.json
credentials*.json
token.json

# Python
__pycache__/
*.py[cod]
/.pytest_cache/
/.ruff_cache/
**/.venv/
*.egg-info/
/trash/

# Node.js development tooling
/.pnpm-store/
/node_modules/
**/node_modules/
/vendor/*/lib/
/packages/*/*/lib/
/apps/*/lib/
*.tsbuildinfo

# Temporary output of Mermaid CLI checks
/.mmd
/*.mmd
debug.log
