{
  "name": "deckagent-tooling",
  "private": true,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "ocr": "ocr",
    "ocr:preview": "ocr delegate preview --format json",
    "ocr:rules": "ocr delegate rule --format json",
    "build": "tsc -b && node scripts/build-foundation.mjs",
    "typecheck": "tsc -b",
    "test:foundation": "node --test tests/foundation.test.mjs",
    "start:foundation": "node apps/foundation/lib/cli.js",
    "test:agent-runtime": "node --test tests/agent-runtime.test.mjs",
    "test:model-providers": "node --test tests/model-providers.test.mjs",
    "test:session-persistence": "node --test tests/session-persistence.test.mjs",
    "test:chat-setup": "node --test tests/chat-setup.test.mjs",
    "chat": "node --use-system-ca apps/agent-runtime/lib/chat.js"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "1.12.7",
    "typescript": "^6.0.3",
    "tsdown": "^0.22.2",
    "@types/node": "^22.20.1",
    "@types/js-yaml": "^4.0.9",
    "@types/semver": "^7.8.0"
  },
  "packageManager": "pnpm@11.28.5",
  "workspaces": [
    "vendor/*",
    "packages/*/*",
    "apps/*"
  ]
}
