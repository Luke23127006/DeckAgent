{
  "name": "deckagent-tooling",
  "private": true,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test:local-foundation": "node --test tests/workspace-registry.test.mjs tests/chat-persistence.test.mjs tests/local-foundation.test.mjs tests/attachment-storage.test.mjs",
    "test:model-requests": "node --test tests/request-lifecycle.test.mjs tests/opencode-adapter.test.mjs tests/model-requests.test.mjs",
    "test:source-permissions": "node --test tests/source-access.test.mjs tests/mcp-bridge.test.mjs tests/step-approval.test.mjs tests/source-requests.test.mjs",
    "test:attachments": "node --test tests/attachment-parser.test.mjs tests/attachment-storage.test.mjs tests/attachment-admission.test.mjs",
    "test:research": "node --test tests/research.test.mjs",
    "test:images": "node --test tests/image-research.test.mjs tests/commons-images.test.mjs tests/portable-generation.test.mjs tests/portable-generation-http.test.mjs",
    "test:research-live": "node --env-file-if-exists=.env --test tests/research-live.test.mjs",
    "test:opencode-live": "node --test tests/opencode-live.test.mjs tests/opencode-source-live.test.mjs tests/opencode-generation-live.test.mjs tests/opencode-brief-live.test.mjs",
    "test:outline-workflow": "node --test tests/outline-state.test.mjs tests/outline-client.test.mjs",
    "test:brief-foundation": "node --test tests/design-catalog.test.mjs tests/deck-brief.test.mjs tests/brief-host.test.mjs tests/brief-client.test.mjs",
    "test:deck-review": "node --test tests/interview-policy.test.mjs tests/interview-workflow.test.mjs tests/bound-outline.test.mjs tests/outline-client.test.mjs",
    "test:generation-publication": "node --test tests/generation-confirmation.test.mjs tests/generation-continuation.test.mjs tests/generation-continuation-http.test.mjs tests/confirmation-host.test.mjs tests/artifact-publication.test.mjs tests/artifact-rendering.test.mjs tests/generation-bridge.test.mjs tests/commons-images.test.mjs tests/image-research.test.mjs tests/research-image-generation.test.mjs tests/slide-document.test.mjs tests/html-template.test.mjs tests/portable-generation.test.mjs tests/portable-generation-http.test.mjs",
    "test:slide-pipeline": "node --test tests/deck-service.test.mjs tests/deck-pipeline.test.mjs tests/deck-model.test.mjs tests/deck-client.test.mjs",
    "ocr": "ocr",
    "ocr:preview": "ocr delegate preview --format json",
    "ocr:rules": "ocr delegate rule --format json",
    "build": "tsc -b && node scripts/build-workspace.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint -c .oxlintrc.json apps packages scripts tests",
    "format": "biome format --write",
    "format:check": "biome format",
    "check:docs": "node scripts/check-docs.mjs",
    "check:comments": "node scripts/check-no-comments.mjs",
    "test:session-persistence": "node --test tests/session-persistence.test.mjs",
    "test:tools-browser": "node --test tests/host-api.test.mjs tests/browser-runtime.test.mjs tests/local-web.test.mjs",
    "start:local-web": "node --env-file-if-exists=.env --use-system-ca apps/local-web/lib/cli.js",
    "start:local": "npm exec --yes --package=node@22.19.0 -- node --env-file-if-exists=.env --use-system-ca apps/local-web/lib/cli.js",
    "package:opencode": "node scripts/package-opencode.mjs",
    "test:opencode-resources": "node --test tests/opencode-resources.test.mjs",
    "test:browser-smoke": "node --test tests/browser-smoke.test.mjs",
    "test:env-startup": "node --test tests/env-startup.test.mjs",
    "test:local-web": "node --test tests/web-session.test.mjs tests/web-management.test.mjs"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "1.12.7",
    "@biomejs/biome": "^2.5.15",
    "@types/css-tree": "2.3.11",
    "@types/node": "^22.20.1",
    "oxlint": "1.94.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.28.5",
  "workspaces": [
    "packages/*/*",
    "apps/*"
  ]
}
