{
  "name": "deckagent-tooling",
  "private": true,
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test:local-foundation": "node --test packages/workspace/registry/tests/workspace-registry.test.mjs packages/session/persistence/tests/chat-persistence.test.mjs e2e/local-foundation.test.mjs e2e/attachment-storage.test.mjs",
    "test:model-requests": "node --test e2e/request-lifecycle.test.mjs apps/web/tests/opencode-adapter.test.mjs e2e/model-requests.test.mjs packages/host/api/tests/request-failure.test.mjs apps/web/tests/wait-for.test.mjs",
    "test:source-permissions": "node --test packages/tools/filesystem/tests/source-access.test.mjs apps/web/tests/mcp-bridge.test.mjs e2e/step-approval.test.mjs e2e/source-requests.test.mjs",
    "test:attachments": "node --test packages/tools/filesystem/tests/attachment-parser.test.mjs e2e/attachment-storage.test.mjs e2e/attachment-admission.test.mjs",
    "test:research": "node --test apps/web/tests/research.test.mjs",
    "test:images": "node --test e2e/image-recovery-http.test.mjs apps/web/tests/image-research.test.mjs apps/web/tests/commons-images.test.mjs e2e/portable-generation.test.mjs e2e/portable-generation-http.test.mjs",
    "test:research-live": "node --env-file-if-exists=.env --test e2e/research-live.test.mjs",
    "test:opencode-live": "node --test e2e/opencode-live.test.mjs e2e/opencode-source-live.test.mjs e2e/opencode-generation-live.test.mjs e2e/opencode-brief-live.test.mjs",
    "test:outline-workflow": "node --test packages/presentation/deck/tests/outline-state.test.mjs apps/web/tests/outline-client.test.mjs",
    "test:brief-foundation": "node --test packages/presentation/design/tests/design-catalog.test.mjs packages/presentation/deck/tests/deck-brief.test.mjs apps/web/tests/brief-host.test.mjs apps/web/tests/brief-client.test.mjs",
    "test:deck-review": "node --test packages/presentation/deck/tests/interview-policy.test.mjs e2e/interview-workflow.test.mjs packages/presentation/deck/tests/bound-outline.test.mjs apps/web/tests/outline-client.test.mjs apps/web/tests/layout-review.test.mjs e2e/layout-review-http.test.mjs",
    "test:generation-publication": "node --test packages/presentation/deck/tests/generation-confirmation.test.mjs packages/presentation/deck/tests/generation-continuation.test.mjs e2e/generation-continuation-http.test.mjs e2e/confirmation-host.test.mjs packages/presentation/deck/tests/artifact-publication.test.mjs e2e/artifact-rendering.test.mjs e2e/generation-bridge.test.mjs apps/web/tests/commons-images.test.mjs apps/web/tests/image-research.test.mjs e2e/image-recovery-http.test.mjs apps/web/tests/research-image-generation.test.mjs packages/presentation/document/tests/slide-document.test.mjs packages/presentation/html/tests/html-template.test.mjs e2e/portable-generation.test.mjs e2e/portable-generation-http.test.mjs packages/presentation/html/tests/html-template-v3.test.mjs packages/presentation/html/tests/layout-quality.test.mjs",
    "test:slide-pipeline": "node --test packages/presentation/deck/tests/deck-service.test.mjs e2e/deck-pipeline.test.mjs apps/web/tests/deck-model.test.mjs apps/web/tests/deck-client.test.mjs",
    "ocr": "ocr",
    "ocr:preview": "ocr delegate preview --format json",
    "ocr:rules": "ocr delegate rule --format json",
    "build": "tsc -b && node scripts/build-workspace.mjs",
    "typecheck": "tsc -b",
    "lint": "oxlint -c .oxlintrc.json apps packages scripts tests e2e",
    "format": "biome format --write",
    "format:check": "biome format",
    "check:docs": "node scripts/check-docs.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:boundaries:report": "node scripts/check-boundaries.mjs --report",
    "test:session-persistence": "node --test packages/session/persistence/tests/session-persistence.test.mjs",
    "test:tools-browser": "node --test packages/host/api/tests/host-api.test.mjs apps/web/tests/browser-runtime.test.mjs e2e/local-web.test.mjs",
    "start:local-web": "node --env-file-if-exists=.env --use-system-ca apps/web/lib/cli.js",
    "start:local": "npm exec --yes --package=node@22.19.0 -- node --env-file-if-exists=.env --use-system-ca apps/web/lib/cli.js",
    "package:opencode": "node scripts/package-opencode.mjs",
    "test:opencode-resources": "node --test apps/web/tests/opencode-resources.test.mjs",
    "test:browser-smoke": "node --test --test-concurrency=1 e2e/browser-smoke.test.mjs e2e/layout-review-browser.test.mjs",
    "test:env-startup": "node --test e2e/env-startup.test.mjs",
    "test:local-web": "node --test apps/web/tests/web-session.test.mjs apps/web/tests/web-management.test.mjs",
    "test:layouts": "node --test packages/presentation/html/tests/html-template-v3.test.mjs packages/presentation/html/tests/layout-quality.test.mjs apps/web/tests/layout-review.test.mjs e2e/layout-review-http.test.mjs",
    "gallery:layouts": "node scripts/layout-gallery.mjs"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "1.12.7",
    "@biomejs/biome": "^2.5.15",
    "@deckagent/deck": "workspace:*",
    "@deckagent/design": "workspace:*",
    "@deckagent/file-tools": "workspace:*",
    "@deckagent/host-api": "workspace:*",
    "@deckagent/host-contracts": "workspace:*",
    "@deckagent/html-format": "workspace:*",
    "@deckagent/local-web": "workspace:*",
    "@deckagent/pptx-format": "workspace:*",
    "@deckagent/presentation-document": "workspace:*",
    "@deckagent/session-persistence": "workspace:*",
    "@deckagent/workspace-registry": "workspace:*",
    "@types/css-tree": "2.3.11",
    "@types/node": "^22.20.1",
    "oxlint": "1.94.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@11.28.5",
  "workspaces": [
    "packages/*/*",
    "apps/*"
  ]
}
